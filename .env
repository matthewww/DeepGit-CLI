# --- Required ---
GITHUB_API_KEY=your_github_pat_here

# --- LLM Configuration ---
# Model used for query expansion. Override with --model flag.
# Groq (free tier, recommended):
DEEPGIT_LLM_MODEL=llama-3.1-8b-instant
DEEPGIT_LLM_BASE_URL=https://api.groq.com/openai/v1

# Ollama (local, no key needed):
# DEEPGIT_LLM_MODEL=llama3
# DEEPGIT_LLM_BASE_URL=http://localhost:11434/v1

# --- Provider API keys (only set the one you need) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key
# OPENAI_API_KEY=your_openai_api_key
GROQ_API_KEY=your_groq_api_key_here